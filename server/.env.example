# ==============================================================================
# InSearch — Server Environment Configuration Template
# Copy this file to '.env' and fill in your real MongoDB connection string.
# DO NOT commit '.env' with real credentials to version control.
# ==============================================================================

# Server Port (default 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Option A (MongoDB Atlas - Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/insearch?retryWrites=true&w=majority
# Option B (Local MongoDB):
# MONGODB_URI=mongodb://127.0.0.1:27017/insearch
MONGODB_URI=mongodb://127.0.0.1:27017/insearch

# Allowed CORS Origins (comma-separated for Live Server / dev ports)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5000

# JSON Web Token (JWT) Configuration
# Generate a secure 64+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Demo Accounts Seeding Configuration (Run via: npm run seed:demo)
# Passwords must be at least 8 characters long
DEMO_ADMIN_PASSWORD=your_demo_admin_password_min_8_chars
DEMO_STUDENT_PASSWORD=your_demo_student_password_min_8_chars

# Quick Demo Login Feature Flag (Strictly disabled in production)
# Set to 'true' ONLY in local development or viva demonstrations
ALLOW_DEMO_LOGIN=false
